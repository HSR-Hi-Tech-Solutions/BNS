# ==============================================================================
# BNS Frontend Environment Configuration
# ==============================================================================
# Note: Variables prefixed with VITE_ are embedded into the client-side bundle.
# NEVER put Google service account keys, private API secrets, or passwords here.
#
# Google Apps Script Web App Deployment URL:
# 1. Deploy your Google Apps Script as a Web App (Execute as: "Me", Access: "Anyone").
# 2. Paste the provided Web App URL below (starts with https://script.google.com/macros/s/...)
# ==============================================================================
VITE_GOOGLE_SHEETS_SCRIPT_URL=https://script.google.com/macros/s/your_google_apps_script_web_app_url_here/exec
