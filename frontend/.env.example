# BNS Frontend Environment Configuration
# Variables prefixed with VITE_ are exposed to the client-side JavaScript bundle.
# NEVER put private credentials, API keys, or database secrets here.

# REST API Base URL
# Local development with Vite proxy: leave blank or set to http://localhost:3001/api/v1
# Production deployment: set to your deployed backend URL (e.g., https://api.bengalnewsservice.com/api/v1)
VITE_API_BASE_URL=http://localhost:3001/api/v1
