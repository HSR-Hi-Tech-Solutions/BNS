# ==============================================================================
# BNS Project — Root .gitignore
# Covers both /frontend and /backend applications and development environments
# ==============================================================================

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/
.pnp
.pnp.js

# Production build outputs & caches
dist/
frontend/dist/
backend/dist/
build/
coverage/
.vite/
frontend/.vite/
backend/.vite/
.cache/
tmp/
temp/

# Environment variables & secrets — NEVER commit real credentials
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Private certificates, keys, & credentials
*.pem
*.key
*.crt
*.p12
*.pfx

# Logs & debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
debug.log*

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# IDE & Editor files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln

# Deployment & hosting caches
.next/
.vercel/
.netlify/

# TypeScript build info (if any)
*.tsbuildinfo

# Archives
*.tgz
*.tar.gz
