# BNS Backend Environment Configuration
# NEVER commit real credentials or production secrets to version control.

# Server Environment & Port
NODE_ENV=development
PORT=3001

# MongoDB Connection String (Required for persistent enquiry storage)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/bns_db?retryWrites=true&w=majority
MONGODB_URI=

# Allowed CORS Origins (comma-separated list of authorized frontend URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
