# BNS Backend Environment Configuration
# NEVER commit real credentials or production secrets to version control.

# Server Environment & Port
NODE_ENV=development
PORT=3001

# MongoDB Connection String (Required for persistent enquiry storage)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/bns_db?retryWrites=true&w=majority
MONGODB_URI=

# Allowed CORS Origins (comma-separated list of authorized frontend URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP Email Configuration (Nodemailer)
# Host and port for outbound mail delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Set to 'true' for port 465 (SSL/TLS), 'false' for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
# Outbound sender address in message headers
SMTP_FROM="Bengal News Service" <no-reply@bengalnewsservice.com>
# Destination inbox for incoming customer enquiry notifications
NOTIFICATION_EMAIL=contact@bengalnewsservice.com
